{
  "name": "dpa-dat-ban",
  "main": "worker.ts",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dpa-bookings",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "."
    }
  ]
}